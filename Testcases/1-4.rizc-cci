// x2 <- visited array
li  x1  1
add sp  sp  x1
add x2  x0  sp  // x2 <- visited (char[8])
li  x1  7
add sp  sp  x1

// x3 <- queue tail, x4 <- queue head
li  x1  1
add sp  sp  x1
add x3  x0  sp  // x3 <- queue tail (char[8])
add x4  x0  sp  // x4 <- &x3[0] (queue head, char*)
li  x1  7
add sp  sp  x1

// Allocate output buffer
li  x1  1
add sp  sp  x1
add op  x0  sp
li  x1  16
add sp  sp  x1
add x9  op  x0

// Enqueue initial vertex
li  x1  1
sb  x1  x2      // visited[0] = 1
li  x1  1
add x3  x3  x1  // tail += 1

// BFS loop
L1: beq x3  x4  E1M // while (head != tail)

    // x5 <- *head (u)
    lb  x5  x4

    // head++
    li  x1  1
    add x4  x4  x1

    // TODO: Output contents of x5
    li  x1  48
    add x1  x5  x1
    sb  x1  x9
    li  x1  1
    add x9  x9  x1
    li  x1  10
    sb  x1  x9
    li  x1  1
    add x9  x9  x1

    li  x6  0       // x6 <- 0 (v)
    li  x7  8       // x7 <- 8 (N)
    L2: beq x6  x7  E2  // while (v < N)

        // x8 <- graph[u]
        add x8  x0  ip
        add x8  x8  x5
        lb  x8  x8

        // x1 <- 1 << v
        li  x1  1
        sll x1  x1  x6

        // x8 <- graph[u] & (1 << v)
        and x8  x8  x1

        // if ((graph[u] & (1 << v)) == (1 << v))
        beq x8  x1  I1
        beq x0  x0  IE1
        I1:

            add x8  x2  x6  // x8 <- visited + v
            lb  x8  x8      // x8 <- visited[v]

            beq x0  x0  E1MF
            E1M:    beq x0  x0  E1
            E1MF:

            beq x0  x0  L1MF
            L1M:    beq x0  x0  L1
            L1MF:

            // if (visited[v] == 0)
            li  x1  0
            beq x8  x1  I2
            beq x0  x0  IE2
            I2:

                // visited[v] = 1
                add x8  x2  x6  // x8 <- visited + v
                li  x1  1       // x1 <- 1
                sb  x1  x8      // *x8 <- x1
                
                // queue[tail] = v
                sb  x6  x3
                
                // tail++
                li  x1  1
                add x3  x3  x1
            
            IE2:
            
        IE1:

        // v++
        li  x1  1
        add x6  x6  x1

        beq x0  x0  L2
    E2:

    beq x0  x0  L1M
E1:

li  x1  0
sb  x1  x9
